<diagram dimensions="(420, 200)" margins="(25, 20, 25, 20)"
 xmlns="https://prefigure.org">
  <definition>EW = (0, 2.5)</definition>
  <definition>MS = (2, 4.5)</definition>
  <definition>DH = (2, 0.5)</definition>
  <definition>KB = (4.7, 2.7)</definition>
  <definition>CB = (7, 4.5)</definition>
  <definition>BP = (7, 0.5)</definition>
  <definition>BW = (9.5, 2.2)</definition>
 
  <coordinates bbox="(-0.5, 0, 10, 5)">
    <!-- edges (drawn first so the vertex dots sit on top) -->
    <group at="edges">
    <line at="e-EW-MS" endpoints="(EW, MS)"/>
    <line at="e-EW-DH" endpoints="(EW, DH)"/>
    <line at="e-MS-DH" endpoints="(MS, DH)"/>
    <line at="e-MS-CB" endpoints="(MS, CB)"/>
    <line at="e-MS-KB" endpoints="(MS, KB)"/>
    <line at="e-MS-BW" endpoints="(MS, BW)"/>
    <line at="e-DH-KB" endpoints="(DH, KB)"/>
    <line at="e-DH-BP" endpoints="(DH, BP)"/>
    <line at="e-DH-BW" endpoints="(DH, BW)"/>
    <line at="e-KB-CB" endpoints="(KB, CB)"/>
    <line at="e-KB-BP" endpoints="(KB, BP)"/>
    <line at="e-CB-BP" endpoints="(CB, BP)"/>
    <line at="e-CB-BW" endpoints="(CB, BW)"/>
    <line at="e-BP-BW" endpoints="(BP, BW)"/>
    </group>
 
    <!-- vertices with labels -->
    <group at="vertices">
    <point at="v-EW" fill="black" size="3" p="EW" alignment="west">EW</point>
    <point at="v-MS" fill="black" size="3" p="MS" alignment="nw">MS</point>
    <point at="v-DH" fill="black" size="3" p="DH" alignment="sw">DH</point>
    <point at="v-KB" fill="black" size="3" p="KB" alignment="west">KB</point>
    <point at="v-CB" fill="black" size="3" p="CB" alignment="ne">CB</point>
    <point at="v-BP" fill="black" size="3" p="BP" alignment="se">BP</point>
    <point at="v-BW" fill="black" size="3" p="BW" alignment="east">BW</point>
    </group>
  </coordinates>
 
